{
  "compilerOptions": {
    // Versión de JS a emitir (moderna, compatible con Node 18+)
    "target": "ES2022",

    // CommonJS: máxima compatibilidad, sin necesidad de extensiones .js
    // "nodenext" + package.json "type": "commonjs" emite CommonJS
    // y NO dispara la deprecación de node10
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Estructura de entrada/salida
    "rootDir": "./src",
    "outDir": "./dist",

    // Interoperabilidad con módulos CommonJS (import default de Express, etc.)
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Chequeo estricto (recomendado; en TS7 sería el default)
    "strict": true,

    // Permite importar archivos .json (útil para configs)
    "resolveJsonModule": true,

    // Ignora el chequeo de tipos de node_modules
    "skipLibCheck": true,

    // Para debugging y para publicar tipos si hiciera falta
    "sourceMap": true,
    "declaration": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}