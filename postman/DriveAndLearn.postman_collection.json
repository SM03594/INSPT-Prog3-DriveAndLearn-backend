        {
          "name": "1.1 Crear Administrador Exitoso",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = `admin_${Date.now()}@escuela.com`;",
                  "pm.collectionVariables.set(\"adminEmail\", uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Retorna el administrador sin exponer password ni __v\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_id\");",
                  "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
                  "    pm.expect(jsonData.rol).to.eql(\"administrador\");",
                  "    pm.expect(jsonData).to.not.have.property(\"password\");",
                  "    pm.expect(jsonData).to.not.have.property(\"__v\");",
                  "    pm.collectionVariables.set(\"adminId\", jsonData._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"NomApe\": \"Carlos Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
