              "raw": "{{baseUrl}}/api/profesores/{{profesorId}}/disponibilidad/quitar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profesores",
                "{{profesorId}}",
                "disponibilidad",
                "quitar"
              ]
            },
            "description": "Quita el tramo de 12:00 a 14:00 del día lunes, dejando disponible de 08:00 a 12:00."
