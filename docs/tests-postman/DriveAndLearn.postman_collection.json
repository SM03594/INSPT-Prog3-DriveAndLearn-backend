              "mode": "raw",
              "raw": "{\n  \"tramos\": [\n    {\n      \"dia\": \"lunes\",\n      \"tramoHorario\": {\n        \"horaInicio\": \"08:00\",\n        \"horaFin\": \"12:00\"\n      }\n    },\n    {\n      \"dia\": \"lunes\",\n      \"tramoHorario\": {\n        \"horaInicio\": \"12:00\",\n        \"horaFin\": \"14:00\"\n      }\n    }\n  ]\n}",
