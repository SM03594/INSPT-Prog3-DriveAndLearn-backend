          "response": []
        },
        {
          "name": "8-ver-turnos-libres-profesor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profesores/{{profesorId}}/turnos-libres?fecha={{fechaClase}}&cambios=MANUAL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profesores",
                "{{profesorId}}",
                "turnos-libres"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{fechaClase}}"
                },
                {
                  "key": "cambios",
                  "value": "MANUAL"
                }
              ]
            },
            "description": "Calcula los turnos libres de 1 hora del profesor para la fecha {{fechaClase}} (lunes) filtrando autos con caja MANUAL."
          },
          "response": []
        }
      ]
