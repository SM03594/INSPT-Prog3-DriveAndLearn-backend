# URI de conexión a MongoDB.
# Ejemplo local: mongodb://127.0.0.1:27017/driveandlearn
MONGODB_URI=mongodb://127.0.0.1:27017/driveandlearn

# Puerto HTTP de la API.
PORT=

# Generar un secreto aleatorio con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Primer administrador. Los usa `npm run admin:desde-env`, que lo
# crea solo si todavía no existe ningún administrador.
# La contraseña debe tener al menos 8 caracteres. Una vez creado,
# conviene borrar ADMIN_PASSWORD de este archivo (o cambiar la
# contraseña desde la API).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional. Por defecto: Administrador
#ADMIN_NOMAPE=Administrador

# Opcional. Horas de diferencia de la escuela con UTC.
# Es la única fuente de la hora de la escuela para toda la app.
# Por defecto: -3
OFFSET_HORA_UTC=-3
