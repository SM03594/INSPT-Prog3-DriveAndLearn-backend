# URI de conexión a MongoDB.
# Ejemplo local: mongodb://127.0.0.1:27017/driveandlearn
MONGODB_URI=mongodb://127.0.0.1:27017/driveandlearn

# Puerto HTTP de la API.
PORT=3000

# Generar un secreto aleatorio con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcional. Por defecto: America/Argentina/Buenos_Aires
ZONA_HORARIA=America/Argentina/Buenos_Aires