{
  // ============================================================
  //  tsconfig.build.json — configuración de COMPILACIÓN
  // ============================================================
  // Se usa SOLO en "npm run build" (tsc -p tsconfig.build.json).
  // Hereda todo de tsconfig.json y cambia lo mínimo para emitir el
  // dist/ que corre en producción ("npm start" -> dist/index.js).
  // El chequeo de tipos del día a día usa tsconfig.json (que además
  // abarca tests/ y no emite nada).

  // Toma todas las "compilerOptions" de tsconfig.json como base...
  "extends": "./tsconfig.json",

  "compilerOptions": {
    // ...y pisa solo estas para habilitar la salida de archivos:

    // Reactiva la emisión (tsconfig.json la apaga con "noEmit": true).
    "noEmit": false,

    // Carpeta raíz de las fuentes: la estructura de src/ se espeja
    // dentro de dist/ (src/models/Auto.ts -> dist/models/Auto.js).
    // Por esto el build NO puede incluir tests/ (viven fuera de src/).
    "rootDir": "./src",

    // Dónde se escribe el JavaScript ya compilado.
    "outDir": "./dist",

    // Emite los .d.ts (tipos) junto a cada .js. Ya viene de
    // tsconfig.json; queda explícito para dejar claro que el build
    // sí publica tipos.
    "declaration": true
  },

  // "include" NO se hereda, se REEMPLAZA: el build compila solo src/,
  // así los *.test.ts quedan afuera de dist/.
  "include": ["src/**/*"]
}
